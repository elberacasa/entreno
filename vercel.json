{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run check && npm run build:web && node scripts/prepare-vercel.mjs",
  "outputDirectory": "dist-vercel",
  "redirects": [
    { "source": "/", "destination": "/entreno/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/entreno/:path*", "destination": "/entreno/index.html" }
  ],
  "headers": [
    {
      "source": "/entreno/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
    }
  ]
}
